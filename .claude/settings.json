{
  "enabledMcpjsonServers": [
    "notion"
  ],
  "permissions": {
    "allow": [
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__notion__notion-query-data-sources",
      "mcp__notion__notion-create-pages",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Read",
      "Edit(/00 Inbox/**)",
      "Edit(/01 Daily/**)",
      "Edit(/02 Ideas/**)",
      "Edit(/03 Projects/**)",
      "Edit(/04 Areas/**)",
      "Edit(/05 Notes/**)",
      "Edit(/06 People/**)",
      "Edit(/07 Archive/**)",
      "Edit(/_me/**)",
      "Edit(/_system/logs/**)",
      "Edit(/_system/attachments/**)",
      "Write(/00 Inbox/**)",
      "Write(/02 Ideas/**)",
      "Write(/03 Projects/**)",
      "Write(/05 Notes/**)",
      "Write(/06 People/**)",
      "Write(/07 Archive/**)",
      "Write(/_system/logs/**)",
      "Write(/_system/attachments/**)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(git show:*)",
      "WebSearch",
      "WebFetch",
      "mcp__notion__notion-update-page",
      "Bash(git fetch:*)"
    ],
    "deny": [
      "Edit(/_system/autonomy.md)",
      "Edit(/_system/escalation.md)",
      "Edit(/.claude/settings.json)",
      "Write(/_system/autonomy.md)",
      "Write(/_system/escalation.md)",
      "Write(/.claude/settings.json)",
      "Bash(git remote add:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(gh repo create:*)",
      "Bash(vercel:*)",
      "Bash(wrangler:*)",
      "Bash(rm -rf:*)",
      "mcp__notion__notion-delete-pages",
      "mcp__notion__notion-move-pages",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin +:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)"
    ]
  }
}
